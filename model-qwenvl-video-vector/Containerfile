FROM continuumio/miniconda3:latest
WORKDIR /elv

# Layers are ordered least- to most-frequently-changing: system packages, conda env,
# ssh known_hosts, package scaffold, pip deps, then source. Anything below an edited
# layer is rebuilt, so nothing that changes per-commit sits above the pip install.

# ffmpeg provides the ffprobe/ffmpeg CLIs used by common_ml.video_processing,
# and the codecs decord/PyAV decode video with. build-essential for any source builds.
RUN apt-get update && apt-get install -y build-essential ffmpeg && rm -rf /var/lib/apt/lists/*

# Qwen3-VL / transformers>=4.57 / torch 2.8 require Python 3.11+
RUN conda create -n mlpod python=3.11 -y

# Create the SSH directory with correct permissions and add GitHub to known_hosts to
# bypass host verification (common-ml is a git dependency).
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
    && ssh-keyscan -t rsa github.com >> /root/.ssh/known_hosts

# The torch 2.8 pip wheels bundle their own CUDA runtime, so no host CUDA toolkit
# install is needed; the container just needs the NVIDIA driver + container toolkit
# at run time (--device nvidia.com/gpu=...).

# setup.py declares packages=["embedding"], so the dir must exist and be an importable
# package at install time. Create __init__.py here (replaced by COPY below) for setuptools.
# Kept above `COPY setup.py` so editing setup.py doesn't rebuild this layer.
RUN mkdir -p embedding && touch embedding/__init__.py

# Install dependencies before copying source so the heavy dependency layer is cached.
# `pip install .` installs the dependencies (incl. common-ml from git); the tagger
# code itself runs from the source copied below (WORKDIR is on sys.path).
COPY setup.py .

# INSTALL_TEST=true also installs the `test` extra (pytest) so this image can run the
# unit tests. See README "Tests".
ARG INSTALL_TEST=false
# The cache mount keeps pip's wheel/HTTP cache outside the image, so editing setup.py
# still reinstalls but re-downloads nothing (torch + CUDA wheels are several GB).
# Nothing is committed to the image. Needs a BuildKit-capable builder, which
# buildscripts/build_container.bash already assumes via --secret/--ssh.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    if [ "$INSTALL_TEST" = "true" ]; then \
        /opt/conda/envs/mlpod/bin/pip install .[test]; \
    else \
        /opt/conda/envs/mlpod/bin/pip install . ; \
    fi

# Qwen3-VL-Embedding-8B weights is pulled from the HuggingFace hub
# the first time the model loads and written to a cache.
# Mount a persistent volume at HF_HOME so the ~16GB download
# happens once and is reused across container runs.
# Uses a podman named volume (`hf_cache`), shared with model-blip2-frame-vector (a host bind mount works too).
# Run with `--volume=hf_cache:/root/.cache` to declare the intended mount point for reusability.
# Kept below the pip install: editing it then costs only the source COPYs, not a reinstall.
ENV HF_HOME=/root/.cache

# Source code last (changes most often).
COPY embedding/__init__.py embedding/model.py embedding/qwen3_vl_embedding.py ./embedding/
COPY config.yml run.py config.py ./
# Unit tests. Only exercised when the image is built with INSTALL_TEST=true.
COPY tests ./tests

ENTRYPOINT ["/opt/conda/envs/mlpod/bin/python", "-u", "run.py"]
